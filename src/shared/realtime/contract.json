{
  "version": 1,
  "internal_api": {
    "capabilities_path": "/auth/socket/capabilities",
    "contract_version": 1
  },
  "topics": {
    "dashboard": "dashboard",
    "board": "board",
    "board_card": "board_card",
    "board_wiki": "board_wiki",
    "board_wiki_private": "board_wiki_private",
