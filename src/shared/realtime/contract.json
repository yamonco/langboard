    "app_settings": "app_settings",
    "ollama_manager": "ollama_manager",
    "global": "global",
    "none": "none"
  },
  "topic_ids": {
    "global": "all",
    "none": "none"
  },
  "identifiers": {
    "short_uid_length": 11
  },
  "protocol_limits": {
    "max_topic_ids": 64,
    "max_topic_id_bytes": 128
  },
  "setting_topic_ids": {
    "api_key": "api_key",
    "user": "user",
    "bot": "bot",
    "internal_bot": "internal_bot",
    "global_relationship": "global_relationship",
    "webhook": "webhook",
