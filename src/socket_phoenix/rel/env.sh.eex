#!/bin/sh

if [ -n "${SOCKET_PHOENIX_CLUSTER_DNS_QUERY:-}" ]; then
  if [ -z "${RELEASE_NODE:-}" ]; then
    echo "RELEASE_NODE is required when Phoenix cluster discovery is enabled" >&2
    exit 1
  fi

  cluster_cookie="${RELEASE_COOKIE:-${SOCKET_PHOENIX_CLUSTER_COOKIE:-}}"
  if [ -z "$cluster_cookie" ]; then
    echo "A Phoenix cluster cookie is required when cluster discovery is enabled" >&2
    exit 1
  fi

  export RELEASE_DISTRIBUTION=name
  export RELEASE_COOKIE="$cluster_cookie"
fi
